{
  "manifest_version": 3,
  "name": "ReplyMate — Context-Aware Reply Assistant",
  "description": "Compose better customer-facing replies directly inside Slack, Gmail, and other web apps.",
  "version": "0.1.0",

  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*",
    "https://app.slack.com/*",
    "https://*.slack.com/*",
    "https://mail.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://app.slack.com/*",
        "https://*.slack.com/*",
        "https://mail.google.com/*",
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },

  "commands": {
    "open-assistant": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Open the ReplyMate assistant for the active composer"
    }
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "ReplyMate"
  }
}
