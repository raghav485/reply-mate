{
  "name": "@replymate/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && ../../node_modules/.bin/esbuild src/content/index.ts --bundle --format=iife --platform=browser --target=chrome114 --outfile=dist/content.js && cp manifest.json dist/manifest.json",
    "build:watch": "tsc --noEmit && vite build --watch --mode development",
    "build:store": "tsc --noEmit && vite build --mode production && ../../node_modules/.bin/esbuild src/content/index.ts --bundle --format=iife --platform=browser --target=chrome114 --outfile=dist/content.js && cp manifest.store.json dist/manifest.json",
    "package:store": "npm run build:store && node ./scripts/package-store-artifact.mjs",
    "capture:store-assets": "npm run build:store && node ./scripts/capture-store-assets.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:store": "npm run build:store && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:debug": "npm run build && playwright test --debug",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@replymate/contracts": "*",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.21.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.52.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
