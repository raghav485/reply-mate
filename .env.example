# ReplyMate local defaults.
# Copy this file to `.env.local` for machine-specific overrides.
# Shell env vars still override both files.
#
# Free product defaults:
# - no ReplyMate account required
# - local models or BYOK providers are configured in the extension settings
# - provider API keys are stored by the local API, not in this file
REPLYMATE_DEPLOYMENT_MODE=local

# Local drafting runtime
REPLYMATE_DRAFT_RUNTIME=ollama
REPLYMATE_DRAFT_MODEL=qwen3:8b
REPLYMATE_DRAFT_BASE_URL=http://127.0.0.1:11434
REPLYMATE_DRAFT_TIMEOUT_MS=45000
REPLYMATE_DRAFT_TEMPERATURE=0.15
REPLYMATE_DRAFT_TOP_P=0.85
REPLYMATE_DRAFT_REPEAT_PENALTY=1.05
REPLYMATE_DRAFT_NUM_PREDICT=420
REPLYMATE_DRAFT_KEEP_ALIVE=15m

# Local parser runtime
REPLYMATE_PARSER_RUNTIME=ollama
REPLYMATE_PARSER_MODEL=minicpm-v:latest
REPLYMATE_PARSER_BASE_URL=http://127.0.0.1:11434
REPLYMATE_PARSER_TIMEOUT_MS=30000
REPLYMATE_PARSER_KEEP_ALIVE=20m
REPLYMATE_PARSER_ALLOW_METADATA_FALLBACK=true

# Optional environment-level cloud drafting fallback for local development
REPLYMATE_CLOUD_DRAFT_BASE_URL=
REPLYMATE_CLOUD_DRAFT_MODEL=
REPLYMATE_CLOUD_DRAFT_API_KEY=
REPLYMATE_CLOUD_DRAFT_TIMEOUT_MS=90000

# Optional local API auth
REPLYMATE_API_TOKEN=

# Dev-only localhost fallback for sensitive extension flows.
# Store/production-sensitive flows should use the native messaging bridge instead.
REPLYMATE_ENABLE_DEV_SENSITIVE_HTTP=1

# Legacy/internal hosted session auth kept for repo compatibility
REPLYMATE_AUTH_SESSION_SECRET=
REPLYMATE_SESSION_ACCESS_TTL_SECONDS=3600
REPLYMATE_SESSION_REFRESH_TTL_DAYS=30

# Legacy/internal durable hosted state
REPLYMATE_DATABASE_URL=
REPLYMATE_PERSISTENCE_FILE=
REPLYMATE_STORAGE_DRIVER=
REPLYMATE_STORAGE_FILESYSTEM_ROOT=
REPLYMATE_STORAGE_BUCKET=
REPLYMATE_STORAGE_REGION=
REPLYMATE_STORAGE_ENDPOINT=
REPLYMATE_STORAGE_ACCESS_KEY_ID=
REPLYMATE_STORAGE_SECRET_ACCESS_KEY=
REPLYMATE_STORAGE_FORCE_PATH_STYLE=

# Legacy/internal billing
REPLYMATE_WEB_APP_BASE_URL=
REPLYMATE_STRIPE_SECRET_KEY=
REPLYMATE_STRIPE_WEBHOOK_SECRET=
REPLYMATE_STRIPE_PRO_PRICE_ID=

# Legacy/internal hosted auth flows
REPLYMATE_BETA_INVITES=
REPLYMATE_EMAIL_DRIVER=console
REPLYMATE_EMAIL_AUTH_FROM=replymate@example.com
REPLYMATE_MAGIC_LINK_TTL_MINUTES=15
REPLYMATE_DEVICE_AUTH_TTL_SECONDS=600
REPLYMATE_DEVICE_AUTH_POLL_INTERVAL_MS=2000

PORT=3000
